{
  "$schema": "om-theme-v1",
  "id": "om.clear",
  "name": "OM Calm",
  "status": "prototype-default-candidate",
  "semanticRules": {
    "actionFamily": "cobalt-azure",
    "focusFamily": "violet",
    "successFamily": "green",
    "warningFamily": "amber",
    "dangerFamily": "red",
    "colorNeverSoleCue": true,
    "darkIsIndependentPair": true
  },
  "light": {
    "surface.base": "#F7F9FC",
    "surface.subtle": "#EFF3F8",
    "surface.raised": "#FFFFFF",
    "surface.overlay": "#FFFFFF",
    "text.primary": "#172033",
    "text.secondary": "#566176",
    "text.tertiary": "#627085",
    "border.subtle": "#D7DEE8",
    "border.strong": "#9BA8B9",
    "accent.primary": "#0067C5",
    "accent.hover": "#0057AA",
    "accent.pressed": "#004A90",
    "accent.onPrimary": "#FFFFFF",
    "accent.soft": "#DDEEFF",
    "state.focus": "#6536D9",
    "state.selected": "#DCEBFF",
    "status.info": "#0067C5",
    "status.success": "#18794E",
    "status.warning": "#8A5A00",
    "status.danger": "#C4333B",
    "message.incoming.surface": "#FFFFFF",
    "message.outgoing.surface": "#E7F2FF",
    "message.failed.surface": "#FFF0F0"
  },
  "dark": {
    "surface.base": "#11151C",
    "surface.subtle": "#171D26",
    "surface.raised": "#1D2530",
    "surface.overlay": "#25303D",
    "text.primary": "#F2F5F8",
    "text.secondary": "#B9C2CE",
    "text.tertiary": "#8F9BAA",
    "border.subtle": "#34404F",
    "border.strong": "#667485",
    "accent.primary": "#66B2FF",
    "accent.hover": "#8AC4FF",
    "accent.pressed": "#4AA4FF",
    "accent.onPrimary": "#07182B",
    "accent.soft": "#183A5B",
    "state.focus": "#B69CFF",
    "state.selected": "#223D5E",
    "status.info": "#66B2FF",
    "status.success": "#5DD6A1",
    "status.warning": "#F6C65B",
    "status.danger": "#FF7B7B",
    "message.incoming.surface": "#1D2530",
    "message.outgoing.surface": "#183A5B",
    "message.failed.surface": "#451D25"
  }
}
