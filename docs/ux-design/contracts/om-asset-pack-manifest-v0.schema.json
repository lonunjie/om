{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://om.invalid/schema/asset-pack-manifest-v0.schema.json",
  "title": "OM Asset Pack Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "kind",
    "license",
    "assets",
    "security"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "theme",
        "wallpaper",
        "sticker",
        "reaction",
        "effect",
        "sound",
        "avatar",
        "mixed"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "author": {
      "type": "string",
      "maxLength": 160
    },
    "license": {
      "type": "string",
      "maxLength": 120
    },
    "optional_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripts",
        "network",
        "external_references",
        "action_remapping"
      ],
      "properties": {
        "scripts": {
          "const": false
        },
        "network": {
          "const": false
        },
        "external_references": {
          "const": false
        },
        "action_remapping": {
          "const": false
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "mime",
          "sha256",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,120}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.).+$"
          },
          "mime": {
            "enum": [
              "image/svg+xml",
              "image/png",
              "image/webp",
              "image/avif",
              "audio/ogg",
              "audio/mpeg",
              "audio/wav"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "theme-token",
              "wallpaper",
              "sticker",
              "reaction",
              "effect-frame",
              "sound",
              "avatar",
              "illustration",
              "icon-skin"
            ]
          },
          "light_variant": {
            "type": "string"
          },
          "dark_variant": {
            "type": "string"
          },
          "static_fallback": {
            "type": "string"
          },
          "reduced_motion_fallback": {
            "type": "string"
          },
          "directionality": {
            "enum": [
              "none",
              "ltr",
              "rtl",
              "mirror"
            ]
          },
          "accessible_description": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
