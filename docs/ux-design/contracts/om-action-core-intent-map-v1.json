      "risk": "security-critical"
    },
    {
      "id": "change-protection-profile",
      "path": "core_intent",
      "intent": "ChangePrivacyPolicy",
      "risk": "security-critical"
    },
    {
      "id": "set-theme",
      "path": "local_presentation",
      "intent": null,
      "risk": "reversible"
    },
    {
      "id": "set-experience-profile",
      "path": "local_presentation",
      "intent": null,
      "risk": "reversible"
    },
    {
      "id": "set-tab-visibility",
      "path": "local_presentation",
      "intent": null,
      "risk": "reversible"
    }
