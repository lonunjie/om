{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM UI semantic action to authority path map v1",
  "revision": "R15",
  "status": "design_reference_subordinate_to_core",
  "invariants": [
    "semantic_action_identity_is_input_independent",
    "canonical_or_security_state_changes_use_typed_core_intents",
    "platform_owned_capabilities_use_platform_adapter",
    "presentation_only_actions_have_no_protocol_authority",
    "omnibar_voice_models_cannot_lower_risk_or_bypass_confirmation"
  ],
  "actions": [
    {
      "id": "send-message",
      "path": "core_intent",
      "intent": "SendMessage",
      "risk": "consequential"
    },
    {
      "id": "retry-message",
      "path": "core_intent",
      "intent": "RetryDelivery",
      "risk": "reversible"
    },
    {
      "id": "attach-media",
      "path": "platform_then_local_or_core",
      "intent": "PrepareAttachment",
      "risk": "reversible"
    },
    {
      "id": "schedule-message",
      "path": "core_intent",
      "intent": "ScheduleComposeIntent",
      "risk": "consequential"
    },
    {
      "id": "create-poll",
      "path": "core_intent",
      "intent": "CreatePoll",
      "risk": "consequential"
    },
    {
      "id": "vote-poll",
      "path": "core_intent",
      "intent": "VotePoll",
      "risk": "consequential"
    },
    {
      "id": "set-disappearing-policy",
