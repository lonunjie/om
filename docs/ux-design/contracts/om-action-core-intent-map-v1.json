      "risk": "reversible"
    },
    {
      "id": "publish-post",
      "path": "core_intent",
      "intent": "PublishPost",
      "risk": "consequential"
    },
    {
      "id": "start-audio-call",
      "path": "core_intent",
      "intent": "StartCallAudio",
      "risk": "consequential"
    },
    {
      "id": "start-video-call",
