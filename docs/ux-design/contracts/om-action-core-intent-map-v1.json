      "risk": "reversible"
    },
    {
      "id": "accept-message-request",
      "path": "core_intent",
      "intent": "AcceptIntroduction",
      "risk": "consequential"
    },
    {
      "id": "share-contact",
      "path": "core_intent",
      "intent": "CreateContactCapsule",
      "risk": "consequential"
    },
    {
      "id": "block-person",
