{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://om.invalid/design/theme-bundle.logical.schema.json",
  "title": "OM Theme Bundle Logical Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "theme_id",
    "name",
    "version",
    "assets",
    "tokens",
    "palettes"
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "surface",
        "surface_subtle",
        "text_primary",
        "text_secondary",
        "accent",
        "accent_on",
        "selection",
        "focus",
        "link",
        "message_own_surface",
        "message_own_text",
        "message_other_surface",
        "message_other_text",
        "info",
        "success",
        "warning",
        "danger"
      ],
      "properties": {
        "canvas": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "surface_subtle": {"$ref": "#/$defs/color"},
        "surface_elevated": {"$ref": "#/$defs/color"},
        "text_primary": {"$ref": "#/$defs/color"},
        "text_secondary": {"$ref": "#/$defs/color"},
        "text_disabled": {"$ref": "#/$defs/color"},
        "border_subtle": {"$ref": "#/$defs/color"},
        "divider": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "accent_on": {"$ref": "#/$defs/color"},
        "selection": {"$ref": "#/$defs/color"},
        "focus": {"$ref": "#/$defs/color"},
        "link": {"$ref": "#/$defs/color"},
        "pressed": {"$ref": "#/$defs/color"},
        "hover": {"$ref": "#/$defs/color"},
        "message_own_surface": {"$ref": "#/$defs/color"},
        "message_own_text": {"$ref": "#/$defs/color"},
        "message_other_surface": {"$ref": "#/$defs/color"},
        "message_other_text": {"$ref": "#/$defs/color"},
        "reply_context": {"$ref": "#/$defs/color"},
        "mention": {"$ref": "#/$defs/color"},
        "unread_marker": {"$ref": "#/$defs/color"},
        "info": {"$ref": "#/$defs/color"},
        "success": {"$ref": "#/$defs/color"},
        "warning": {"$ref": "#/$defs/color"},
        "danger": {"$ref": "#/$defs/color"}
      }
    }
  },
  "properties": {
    "schema": {
      "const": "om.theme.v1"
    },
    "theme_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "author": {
      "type": "string",
      "maxLength": 256
    },
    "tokens": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "description": "Declarative non-color design tokens only. Density and reduced-motion/user motion preference are not theme-owned. Implementations validate values against safe ranges and reserved semantic constraints."
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
            "description": "Relative ASCII path with no absolute prefix, dot/dot-dot segment or backslash alias. Import additionally rejects duplicate normalized paths."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "kind": {
            "enum": [
              "font",
              "wallpaper",
              "sound",
              "icon"
            ],
            "description": "icon assets are decorative only and cannot bind/replace semantic action or security icon IDs"
          },
          "media_type": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "signature": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional provenance signature. It does not grant execution/trust privileges."
    },
    "palettes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "$ref": "#/$defs/palette"
        },
        "dark": {
          "$ref": "#/$defs/palette"
        }
      },
      "description": "Both authored modes are mandatory. Auto selects between them. The importer validates contrast and reserved semantic constraints in each mode."
    }
  }
}
