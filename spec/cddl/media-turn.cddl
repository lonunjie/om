; ADR-0221 — optional own-Home ICE resources, om.media.turn.v1.
; Canonical deterministic CBOR. No change to the frozen base Home API.
media-turn-request = {
  0: 1,                         ; API major
  1: bstr .size 16,             ; random idempotency identity
}

media-turn-lease = {
  0: 1,
  1: [1*8 tstr .size (1..256)], ; TURN or TURNS URIs
  2: tstr .size (1..256),       ; TURN username
  3: tstr .size (1..256),       ; TURN credential
  4: uint,                     ; expires_at, POSIX seconds (provider retention)
}
