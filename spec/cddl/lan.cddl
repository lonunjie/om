; Status: frozen for W1 local_delivery by ADR-0158 (2026-09-29).
; Transport-local canonical records. They convey no account/conversation authority by themselves.

lan-invite-rendezvous-v1 = {
  0: 1,                                      ; profile_version
}

lan-signal-envelope-v1 = {
  0: 1,                                      ; version
  1: 1..2,                                   ; kind: offer=1, answer=2
  2: bstr .size 16,                          ; session_id, fresh per attempt
  3: uint,                                   ; rendezvous_epoch = floor(posix/900)
  4: bstr .size 12,                          ; fresh AES-256-GCM-SIV nonce
  5: bstr .size (17..12304),                 ; encrypted UTF-8 SDP + tag
}

; One ordered/reliable WebRTC DataChannel message carries exactly one canonical lan-frame-v1.
; payload chunks are deliberately <=16 KiB regardless of runtime/SCTP max-message-size.
lan-frame-v1 = lan-object-begin / lan-object-chunk / lan-object-end /
               lan-ack / lan-fetch-async-key / lan-fetch-blob / lan-error

lan-object-begin = {
  0: 1,                                      ; version
  1: 1,                                      ; kind = object_begin
  2: bstr .size 16,                          ; transfer_id
  3: 1..8,                                   ; object_kind
  4: 0..18446744073709551615,                ; total_bytes (streamed; never eager allocation)
  5: bstr .size 32,                          ; SHA-256 of exact transported bytes
}
lan-object-chunk = {
  0: 1,
  1: 2,                                      ; kind = object_chunk
  2: bstr .size 16,
  6: 0..18446744073709551615,                ; absolute offset
  7: bstr .size (1..16384),                  ; bytes
}
lan-object-end = {
  0: 1,
  1: 3,                                      ; kind = object_end
  2: bstr .size 16,
}
lan-ack = {
  0: 1,
  1: 4,                                      ; kind = ack
  2: bstr .size 16,
  14: 0..18446744073709551615,               ; highest contiguous byte offset durably accepted
}
lan-fetch-async-key = {
  0: 1,
  1: 5,                                      ; kind = fetch_async_key
  2: bstr .size 16,                          ; request_id
  8: device-id,                              ; target recipient DeviceID
  9: profile-id,
  10: bstr .size (16..64),                   ; relationship-scoped key-material fetch capability
}
lan-fetch-blob = {
  0: 1,
  1: 6,                                      ; kind = fetch_blob
  2: bstr .size 16,                          ; request_id
  10: bstr .size (16..64),                   ; object-scoped blob/read capability
  11: blob-id,
  12: bstr .size 32,                         ; expected ciphertext_digest bytes (SHA-256 profile)
}
lan-error = {
  0: 1,
  1: 7,                                      ; kind = error
  2: bstr .size 16,                          ; request/transfer id
  13: 1..65535,                              ; bounded profile error code; no free-form peer-controlled text
}
