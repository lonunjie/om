; Status: frozen (ADR-0119) and amended/re-frozen by ADR-0140 (2026-09-27); keys 3/4 retired/reserved; key 8 mandatory.
; W0 asynchronous key material (ASYNC_KEY_MATERIAL.md). Key sizes admit X25519 (32) .. ML-KEM-1024 (1568).

signed-AsyncKeyBundle = { 1: bstr .cbor AsyncKeyBundle, 2: [1*16 signature] }
AsyncKeyBundle = {
  0: 9, 1: 1,
  2: device-id,                             ; subject_device_id
  ; keys 3 and 4 are retired/reserved by ADR-0140 and MUST be absent
  5: profile-id,                            ; crypto_profile
  6: uint,                                  ; generation
  7: prekey-item,                           ; signed_prekey
  8: prekey-item,                           ; pq_signed_prekey (mandatory, ADR-0126)
  ? 9: [1*100 prekey-item],                 ; one_time_prekeys
  ? 10: [1*32 prekey-item],                 ; pq_one_time_prekeys
  ? 11: prekey-item,                        ; pq_last_resort_prekey
  12: opaque-id16,                          ; provider_pool_id (disjoint pools per provider)
  13: posix-seconds,                        ; expires_at
  ? 23: extensions,
}
prekey-item = {
  0: uint .le 4294967295,                   ; key_id
  1: 1..5,                                  ; kind
  2: bstr .size (32..1568),                 ; public_key
  ? 3: bstr .size (1..8192),                ; one-time kinds: device signature over ADR-0140 context tuple
}
