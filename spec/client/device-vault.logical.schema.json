{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM DeviceVault capability description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vault_version",
    "capabilities"
  ],
  "properties": {
    "vault_version": {
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "webauthn_prf",
          "webcrypto_nonextractable",
          "passphrase_argon2id",
          "native_keystore",
          "hardware_authenticator"
        ]
      }
    },
    "profile_namespaces": {
      "type": "boolean",
      "const": true
    },
    "wrapping_credential_class": {
      "enum": [
        "device_bound",
        "synced_separate",
        "synced_shared_salt_only"
      ],
      "description": "which credential wraps the vault relative to the RecoveryRoot; synced_shared_salt_only is the reduced at-rest case that must be stated to the user (ADR-0129 rule 15)"
    }
  }
}
