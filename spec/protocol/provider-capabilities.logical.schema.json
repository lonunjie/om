{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.om.example/v1/provider-capabilities.schema.json",
  "title": "OM ProviderCapabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "provider_kinds",
    "durability_class",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "directory",
          "discovery_relay",
          "intro_gate",
          "key_material",
          "transparency_witness",
          "relay",
          "push",
          "blob",
          "backup",
          "recovery",
          "media",
          "transport",
          "link_preview",
          "safety_advisory"
        ]
      }
    },
    "durability_class": {
      "enum": [
        "ephemeral",
        "best_effort",
        "durable",
        "archive"
      ]
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
      }
    },
    "api_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?$"
      }
    },
    "health": {
      "enum": [
        "healthy",
        "degraded",
        "unhealthy",
        "unknown"
      ]
    },
    "quota_state": {
      "type": "object"
    },
    "cost_state": {
      "type": "object"
    },
    "failure_domain": {
      "type": "object",
      "properties": {
        "operator": {
          "type": "string"
        },
        "cloud": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "asn": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "privacy_properties": {
      "type": "object"
    },
    "abuse_controls": {
      "type": "object"
    },
    "security_properties": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "recovery_scope_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url without padding of a 32-byte public random RecoveryStore scope id; present when the recovery role supports ADR-0138 RecoveryRecord capability derivation"
    }
  },
  "ProviderCapabilities": {
    "provider_kind": [
      "directory",
      "discovery_relay",
      "intro_gate",
      "key_material",
      "transparency_witness",
      "relay",
      "push",
      "blob",
      "backup",
      "recovery",
      "media",
      "transport",
      "link_preview",
      "safety_advisory"
    ],
    "note": "Compatibility summary for architecture validator; normative validation is the JSON Schema properties above."
  }
}
