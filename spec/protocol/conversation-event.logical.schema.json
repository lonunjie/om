{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmessaging.example/schema/conversation-event-v0.json",
  "title": "OM ConversationEvent logical draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "event_id",
    "conversation_id",
    "author_principal",
    "author_endpoint_id",
    "clock",
    "kind",
    "kind_version",
    "body"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "description": "Opaque 128-bit random ID; final encoding TBD"
    },
    "conversation_id": {
      "type": "string"
    },
    "author_principal": {
      "$ref": "principal-ref.logical.schema.json"
    },
    "author_endpoint_id": {
      "type": "string",
      "description": "Authenticated endpoint credential ID under the typed author principal; DeviceIdentity for account authors, service endpoint for service authors, bridge endpoint for bridge authors"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_ms",
        "logical",
        "endpoint_tiebreak"
      ],
      "properties": {
        "physical_ms": {
          "type": "integer",
          "minimum": 0
        },
        "logical": {
          "type": "integer",
          "minimum": 0
        },
        "endpoint_tiebreak": {
          "type": "string",
          "description": "Stable deterministic tiebreak derived from the authenticated author endpoint, not authorization authority"
        }
      }
    },
    "kind": {
      "enum": [
        "message.create",
        "message.edit",
        "message.delete",
        "reaction.set",
        "receipt.update",
        "pin.set",
        "moderation.redact",
        "poll.create",
        "poll.vote",
        "poll.close",
        "topic.create",
        "topic.update",
        "topic.status.set",
        "message.topic.set"
      ]
    },
    "kind_version": {
      "type": "integer",
      "minimum": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "body": {
      "type": "object"
    },
    "expiry": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "representation": {
      "anyOf": [
        {
          "$ref": "representation-grant.logical.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional service-authored on-behalf-of Account representation; does not change canonical author_principal"
    },
    "foreign_provenance": {
      "anyOf": [
        {
          "$ref": "foreign-provenance.logical.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bridge-attested external-network provenance; required by bridge policy for bridged foreign events"
    }
  }
}
