{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM RelaySet logical schema",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "relay_uri",
          "capability",
          "priority",
          "expires_at"
        ],
        "properties": {
          "relay_uri": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "weight": {
            "type": [
              "integer",
              "null"
            ]
          },
          "expires_at": {
            "type": "string"
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "privacy_hints": {
            "type": "object"
          },
          "cost_hints": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "authentication": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
