{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM EvidencePackage (logical, non-normative)",
  "type": "object",
  "required": [
    "version",
    "package_id",
    "created_at",
    "items"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "package_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reporter_statement": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "payload"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "payload": {},
          "verification_context": {}
        }
      }
    },
    "privacy_note": {
      "type": "string"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
