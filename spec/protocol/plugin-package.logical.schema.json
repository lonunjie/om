{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM PluginPackageRelease logical schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["plugin_id", "release_sequence", "component_hashes", "om_plugin_abi_versions", "entrypoints", "requested_capabilities", "publisher_proof"],
  "properties": {
    "plugin_id": {"type": "string", "description": "Random stable 256-bit PluginID"},
    "release_sequence": {"type": "integer", "minimum": 1},
    "previous_release_id": {"type": ["string", "null"]},
    "component_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "om_plugin_abi_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entrypoints": {"type": "array", "items": {"type": "string"}},
    "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requested_network_origins": {"type": "array", "items": {"type": "string"}},
    "resource_limits": {"type": "object", "additionalProperties": true},
    "publisher_proof": {"type": "object", "description": "Signed update/provenance continuity; not safety endorsement"},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  }
}
