{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OM ModerationDecision and SafetyAdvisory logical schema",
  "$defs": {
    "ModerationDecision": {
      "$comment": "A record, export and appeal object; it never changes Room state by itself. In-Room effect comes only from a GroupControlTransition (remove, ban, restriction) or a moderation.redact event (ADR-0128 rule 12). starts_at/expires_at are display/wall-clock-advisory time with authority_effect none: a ban or restriction ends only through a committed lift transition.",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "scope_ref", "actor_principal", "action", "subject_ref", "authorization_evidence"],
      "properties": {
        "decision_id": {"type": "string"},
        "scope_ref": {"type": "object"},
        "actor_principal": {"$ref": "principal-ref.logical.schema.json"},
        "action": {"enum": ["redact", "timeout", "remove", "ban", "admission_deny", "slow_mode", "restore_future_eligibility", "decision_revoke"]},
        "subject_ref": {"type": "object"},
        "target_event_id": {"type": ["string", "null"]},
        "reason_code": {"type": ["string", "null"]},
        "public_reason_text": {"type": ["string", "null"]},
        "starts_at": {"type": ["integer", "null"], "minimum": 0},
        "expires_at": {"type": ["integer", "null"], "minimum": 0},
        "evidence_commitment": {"type": ["string", "null"]},
        "appeal_descriptor": {"type": ["object", "null"]},
        "previous_decision_id": {"type": ["string", "null"]},
        "authorization_evidence": {"type": "object"}
      }
    },
    "SafetyAdvisory": {
      "$comment": "issued_at/expires_at are wall-clock-advisory time with authority_effect none; a subscriber may stop applying an expired advisory, but an advisory never has protocol authority (ADR-0128 rule 12).",
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_id", "issuer", "subject_ref", "category", "issued_at", "signature"],
      "properties": {
        "advisory_id": {"type": "string"},
        "issuer": {"type": "object"},
        "subject_ref": {"type": "object"},
        "category": {"type": "string"},
        "severity_hint": {"type": ["string", "null"]},
        "scope_hint": {"type": ["string", "null"]},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": ["integer", "null"], "minimum": 0},
        "evidence_reference": {"type": ["object", "null"]},
        "policy_reference": {"type": ["string", "null"]},
        "supersedes": {"type": ["string", "null"]},
        "signature": {"type": "object"}
      }
    },
    "ScopedModerationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "issuer_scope_id", "digest"],
      "properties": {
        "scheme": {"const": "OM-SAFETY-REF-v1"},
        "issuer_scope_id": {"type": "string"},
        "digest": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/ModerationDecision"},
    {"$ref": "#/$defs/SafetyAdvisory"},
    {"$ref": "#/$defs/ScopedModerationRef"}
  ]
}
