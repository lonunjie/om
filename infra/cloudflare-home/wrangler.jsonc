// OM reference Home: Worker + SQLite Durable Objects. PLACEHOLDERS ONLY. No account id, no token, no secret lives in this
// file or anywhere in the repository. See docs/reports/2026-10-28-relay-status.md "Deploy plan" for the exact steps.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Change per deployment. Pick a name that is not a person (a Worker name is public in its workers.dev hostname).
  "name": "om-home-lonunjie",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Zero-domain personal use (CLOUDFLARE_REFERENCE_DEPLOYMENT.md): <name>.<account-subdomain>.workers.dev.
  "workers_dev": true,
  "preview_urls": false,
  // No Workers Logs, no Logpush, no tracing: the Home keeps no request log (SEALED_SENDER_DELIVERY_PROFILE.md section 13).
  "observability": { "enabled": false },
  "vars": {
    "OM_PROVIDER_ID": "om-reference-home",
    // "1" on the Workers Free plan: exhausting a Durable Object limit is a hard stop, reported in quota details.
    "OM_HARD_FREE_TIER": "1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUEUES", "class_name": "MailboxQueue" },
      { "name": "KEYS", "class_name": "KeyPool" },
      { "name": "DESCRIPTORS", "class_name": "DescriptorStore" },
      { "name": "INTRO", "class_name": "IntroGate" }
    ]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan; no R2, KV or Queues binding is needed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailboxQueue", "KeyPool", "DescriptorStore", "IntroGate"] }
  ]
}
