# systemd unit for a self-hosted OM Home. See ../README.md ("Run under systemd") for the install steps.
[Unit]
Description=OM Home (SQLite)
Documentation=file:///opt/om-home/README.md
After=network-online.target
Wants=network-online.target
# Start-up failures that retrying cannot fix (bad directory, port taken) stop after a few tries instead of looping.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
# /var/lib/om-home, owned by the dynamic user and closed to everyone else. One Home per directory.
StateDirectory=om-home
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/om-home/om-home.env
Environment=OM_DATA_DIR=/var/lib/om-home
ExecStart=/usr/bin/node /opt/om-home/home.mjs
# A stop is a clean close (SIGTERM). Give open sockets a moment, then end it.
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

# The Home needs the network and its own directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
# The request log stays off: nothing is written to the journal beyond start and stop lines.
StandardOutput=journal
StandardError=journal
# A bound on one Home's memory and processes, so a fault cannot take the machine with it. Adjust to the machine.
MemoryMax=1G
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
