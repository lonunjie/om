# Copy to /etc/om-home/om-home.env (owner root, mode 0600) and set the value. Not a secret: it is the hash OM shows on its setup screen.
OM_ADMISSION=<your OM setup value>
# Listen on loopback; an HTTPS proxy on the same machine forwards to it (see ../README.md).
OM_HOST=127.0.0.1
OM_PORT=8787
# Optional: OM_WAKE=0, OM_BLOB_SPOOL=0 or OM_RECOVERY_STORE=0 turn a feature off. OM_PROFILE=default selects the larger limits.
