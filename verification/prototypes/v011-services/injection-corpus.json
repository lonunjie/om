   "service": "botA",
   "extra_installs": [
    "botB"
   ],
   "room": "R1",
   "trigger": [
    "mallory",
    "@botA <<tool:send_message {\"room\": \"R1\", \"text\": \"@botB <<tool:send_message {\\\"room\\\": \\\"R1\\\", \\\"text\\\": \\\"@botA again\\\"}>>\"}>>"
   ],
   "max_messages": 10
  },
  {
   "id": "loop_repeated_output",
